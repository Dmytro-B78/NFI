{
  "private_config": "../user_data/config-private.json",
  "env_file": "../.env",
  "blacklist_file": "../user_data/blacklist-binance.json",
  "state_file": "blacklist_scout_state.json",
  "log_file": "blacklist_scout_log.csv",
  "telegram_api_base": "https://api.telegram.org",
  "binance_base": "https://fapi.binance.com",
  "author_blacklist_url": "https://raw.githubusercontent.com/iterativv/NostalgiaForInfinity/main/configs/blacklist-binance.json",
  "request_timeout_sec": 15,
  "request_pause_sec": 0.1,
  "retry_attempts": 3,
  "retry_pause_sec": 5,
  "message_max_len": 4000,
  "quote": "USDT",
  "universe_top_n": 130,
  "hourly_candles": 96,
  "daily_candles": 499,
  "window_hours": 24,
  "delivery_far_future_ms": 4102444800000,
  "renotify_hours": 72,
  "author_reason_max_len": 160,
  "thresholds": {
    "hour_range_pct": 80.0,
    "day_range_pct": 100.0,
    "swing_range_pct": 50.0,
    "swing_net_to_range": 0.33,
    "bleed_high_days": 90,
    "bleed_off_high_pct": 55.0,
    "bleed_7d_pct": 30.0
  },
  "tiers": {
    "perm": ["delist", "status", "author"],
    "temp": ["hour_spike", "day_spike", "swing_flat"],
    "notify": ["bleed"]
  },
  "shadow_mode": true,
  "temp_block_days": 7,
  "escalation_count": 3,
  "escalation_days": 30,
  "max_new_blocks_per_run": 5,
  "never_block": ["BTC", "ETH", "BNB", "SOL", "XRP"],
  "digest_hour_utc": 6,
  "persist_command_template": ".\\scripts\\persist_blacklist.ps1 {bases}",
  "escalation_text": "временный блок {n}-й раз за 30 д",
  "reason_templates": {
    "delist": "Binance: контракт закрывается {date} UTC",
    "status": "Binance: статус контракта {status}",
    "author": "в блэклисте автора: {reason}",
    "hour_spike": "час {time} UTC: диапазон {range:.0f}%",
    "day_spike": "24 ч до {time} UTC: диапазон {range:.0f}%",
    "swing_flat": "24 ч до {time} UTC: диапазон {range:.0f}% при итоге {change:+.1f}%",
    "bleed": "слив: {off_high:+.0f}% от хая за {days} д, {change_7d:+.0f}% за 7 д, красных дней подряд {streak}"
  },
  "na_text": "н/д",
  "age_template": "{days} д",
  "pair_template": "{pair}{where}\n  {reasons}\n  цена {price:.6g}, объём 24ч {qvol_m:.1f}M, от хая {off_high_txt}, от первой свечи {vs_first_txt}, возраст {age_txt}\n  паттерн: \"({base})/.*\"",
  "where_whitelist": " [в вайтлисте]",
  "where_trade": " [открыта сделка #{trade_id}]",
  "msg": {
    "header": "Blacklist scout {ts} UTC",
    "shadow_mark": " [ТЕНЕВОЙ РЕЖИМ: в боте ничего не заблокировано]",
    "h_new_temp": "Временный блок:",
    "h_new_perm": "Постоянный блок, закрепить навсегда в файле:",
    "h_skipped": "НЕ заблокировано (лимит {n} новых блоков за запуск):",
    "h_notify": "Только сообщение (решать тебе):",
    "item": "  {pair}{where} -- {text}",
    "item_temp": "  {pair}{where} до {until} UTC -- {text}",
    "persist": "  Закрепить: {cmd}",
    "h_released": "Снят временный блок (срок вышел, признаков нет): {pairs}",
    "h_persisted": "Закреплено в файле, скрипт больше не ведёт: {pairs}",
    "h_restored": "Блоки восстановлены после рестарта бота: {pairs}",
    "totals": "Сейчас: временных блоков {temp}, ждут закрепления в файле {perm}",
    "digest_header": "Blacklist scout: сводка {ts} UTC",
    "d_cut": "Из текущего вайтлиста ({w} пар) под блоком: {m}",
    "d_temp": "Временные блоки ({n}):",
    "d_temp_item": "  {pair} до {until} UTC -- {text}",
    "d_perm": "Ждут закрепления в файле ({n}):",
    "d_perm_item": "  {pair} с {since} -- {text}",
    "d_file": "В blacklist-binance.json записей: {n}"
  },
  "error_template": "Blacklist scout {ts} UTC: ОШИБКА, проверка не выполнена: {error}"
}
